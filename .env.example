# =========================
# APP
# =========================

APP_NAME=Kyroo
APP_VERSION=1.0.0
ENVIRONMENT=development

# =========================
# DATABASE
# =========================

DATABASE_URL=

# =========================
# LLM
# =========================

LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=

OPENAI_API_KEY=

GEMINI_API_KEY=

OPENROUTER_API_KEY=

# =========================
# WHATSAPP
# =========================

WHATSAPP_TOKEN=

PHONE_NUMBER_ID=

VERIFY_TOKEN=

# Meta App Dashboard -> Settings -> Basic -> App Secret. Required to verify
# the X-Hub-Signature-256 header on inbound webhook POSTs — without this set,
# signature verification is skipped (anyone who finds the webhook URL could
# POST a forged WhatsApp message and have it processed as real).
WHATSAPP_APP_SECRET=

# =========================
# SECURITY
# =========================

SECRET_KEY=

ALGORITHM=HS256

# Shared secret required (as an X-Cron-Secret header or ?secret= query
# param) to call /nudges/check-and-send, /reminders/check-and-send, and
# /stories/refresh — these were public with zero auth before. Set the same
# value here, as a GitHub Actions repo secret named CRON_SECRET (for the
# nudges/stories workflows), and appended to whatever external cron service
# calls /reminders/check-and-send.
CRON_SECRET=