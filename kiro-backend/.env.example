# Copy this file to .env and fill in real values.
# Required for the AI chat brain to respond:
ANTHROPIC_API_KEY=

# Required for any database-backed route (signup, chat history, tracking, etc.):
SUPABASE_URL=
SUPABASE_KEY=

# Required to send OTP verification emails (via Resend's HTTP API, not SMTP):
# Get RESEND_API_KEY from https://resend.com after signing up.
# RESEND_FROM_EMAIL defaults to "KYROO <onboarding@resend.dev>", which only
# delivers to the email you signed up to Resend with — verify a real sending
# domain (e.g. kyroo.co.in) in the Resend dashboard, then set this to
# something like "KYROO <otp@kyroo.co.in>" to send to real users.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional — payments (Razorpay test/live keys):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook. A DIFFERENT
# secret from RAZORPAY_KEY_SECRET above — verifies /payments/webhook so
# payment confirmation isn't only reachable via the client-side call (which
# can be missed if the tab closes right after paying). Required for the
# webhook to work at all — it 503s until this is set.
RAZORPAY_WEBHOOK_SECRET=

# Optional — WhatsApp delivery via Meta Cloud API (leave blank to run in "pending_setup" mode):
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=kyroo_verify_2026
# Meta App Dashboard -> Settings -> Basic -> App Secret — verifies the
# X-Hub-Signature-256 header on inbound /whatsapp/webhook POSTs. Same value
# as app/'s WHATSAPP_APP_SECRET (same Meta App).
WHATSAPP_APP_SECRET=

# Shared secret required to call /whatsapp/send, /whatsapp/morning-nudge-send,
# and /whatsapp/send-all-nudges — these had zero auth and could send
# arbitrary WhatsApp messages to any or all users. Same value as app/'s
# CRON_SECRET, sent as an X-Cron-Secret header or ?secret= query param.
CRON_SECRET=

# Optional — semantic memory (leave blank to skip memory search/save silently):
VOYAGE_API_KEY=

# Required to use the internal admin dashboard (search users, view profile +
# recent chat history, comp/refund via plan change, activate/deactivate).
# Pick any long random string — sent as an X-Admin-Secret header from the
# /admin frontend page. 403s on every /admin/* route until this is set.
ADMIN_SECRET=
