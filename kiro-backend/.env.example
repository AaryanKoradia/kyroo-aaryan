# Copy this file to .env and fill in real values.
# Required for the AI chat brain to respond:
ANTHROPIC_API_KEY=

# Required for any database-backed route (signup, chat history, tracking, etc.):
SUPABASE_URL=
SUPABASE_KEY=

# Required to send OTP verification emails (via Resend's HTTP API, not SMTP):
# Get RESEND_API_KEY from https://resend.com after signing up.
# RESEND_FROM_EMAIL defaults to "KYROO <onboarding@resend.dev>", which only
# delivers to the email you signed up to Resend with — verify a real sending
# domain (e.g. kyroo.co.in) in the Resend dashboard, then set this to
# something like "KYROO <otp@kyroo.co.in>" to send to real users.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional — payments (Razorpay test/live keys):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — WhatsApp delivery via Meta Cloud API (leave blank to run in "pending_setup" mode):
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=kyroo_verify_2026

# Optional — semantic memory (leave blank to skip memory search/save silently):
VOYAGE_API_KEY=
